# 监听端口（容器内固定 8787，compose 场景下此为宿主机映射端口）
TEAMAI_PORT=8787

# JWT 签名密钥，同时用于虚拟 Key 加密——生产必须替换为随机长字符串
# 生成：openssl rand -hex 32
TEAMAI_JWT_SECRET=change-me-to-a-long-random-string

# 首次启动时播种的管理员账号（已存在管理员则不生效）
TEAMAI_ADMIN_EMAIL=admin@teamai.local
TEAMAI_ADMIN_PASSWORD=admin123

# 数据目录（SQLite / 上传文件 / 内置 Git 仓库）；裸机部署时使用，docker 内固定 /data
TEAMAI_DATA_DIR=./data

# 在线环境后端：auto / process / docker
TEAMAI_ENV_RUNNER=auto
# docker 后端使用的镜像
TEAMAI_ENV_IMAGE=node:22-alpine
